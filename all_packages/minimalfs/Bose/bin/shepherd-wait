#!/bin/bash
#
# After we've changed the Shepherd*.xml files, wait for the changes to take
# effect.
#
this=${0##*/}

if (( $# == 0 )); then
    set /var/run/shepherd /var/run/shepherd/pid
fi

if (( $# != 2 )); then
    echo >&2 "usage: $this run-dir pid-file"
    echo >&2 "ex: $this /var/run/shepherd /var/run/shepherd/pid"
    exit 1
fi
rundir=$1; shift
pidfile=$1; shift

pid=$(cat "$pidfile") || exit

cd "$rundir" || exit
touch flux || exit

kill -HUP "$pid" || exit

i=30
while [ -e flux ]; do
    if (( ( i -= 1 ) <= 0 )); then
        echo "$this: Giving up waiting for Shepherd to finish transition"
        exit 1
    fi
    if (( i % 5 == 0 )); then
        echo "$this: Still waiting for Shepherd to finish transition"
    fi
    sleep 1
done

echo "$this: Shepherd transition is complete"
