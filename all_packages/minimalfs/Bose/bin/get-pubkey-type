-----END CERTIFICATE-----'

check_chain "$PRODUCTION_ROOT"     $CERT_DIR && echo production && exit 0
check_chain "$PRODUCTION_PSS_ROOT" $CERT_DIR && echo production && exit 0
check_chain "$DEVELOPMENT_ROOT"    $CERT_DIR && echo development && exit 0

# The development chain is broken -- it incorrectly sets the X509v3 CA
# extension to false. Hardcode the shasum of the certificate until the
# chain is fixed.
case `openssl sha256 -r $CERT_DIR/$ATTESTATION_PATH 2>/dev/null` in
  0ac46e7c8f229a19fe8ee0827d6f252a7c41523f2a1e0529dfae7e3d07d45f57\ *)
    echo development && exit 0
    ;;
esac

echo unknown
exit 1
