#!/bin/sh

# Determine if firmware is production or development signed. Usage:
#   get-pubkey-type [PATH-TO-CERT-CHAINS]
if [ $# -gt 1 ]; then
  echo "usage: $0 [/opt/Bose/etc/secure/publicKeys/bose_public_key_swupdate.pem]" >/dev/stderr
  exit 1
fi

# On Coronado systems the signature type is tied to MRC fuse values.
# This file is created by signature-type.service.
if [ $# == 0 ] && [ -f /var/run/signature-type ]; then
  cat /var/run/signature-type
  exit 0
fi

# Existing usage of this script passes in the path of the attestation
# certificate. (Confusingly, this is mislabeled as the "public key".)
# To maintain compatibility, strip off the final two path components
# in order to isolate the directory containing all the certificates.
ATTESTATION_PATH="publicKeys/bose_public_key_swupdate.pem"
CA_CHAIN_PATH="CACerts/bose_ca_cert_swupdate.pem"
CERT_DIR=`dirname ${1:-/opt/Bose/etc/secure/$ATTESTATION_PATH}`
CERT_DIR=`dirname $CERT_DIR}`

# Checks if the chain under $2 is valid against the root in $1.
check_chain() {
    echo "$1" | \
    openssl verify >/dev/null 2>&1 \
        -CAfile /dev/stdin \
        -untrusted "$2/$CA_CHAIN_PATH" \
        "$2/$ATTESTATION_PATH"
}

