#!/bin/bash
# Initialize the AudioPath hardware.

if (( $# > 0 )); then
    echo >&2 "$0: unexpected argument '$1'"
    exit 1
fi

function cset {
    amixer --quiet cset "$@"
}

# Hack to work around a systemd boot ordering dependency (CASTLE-2106).
i=0
while ! cset name="SLIMBUS_6_RX Audio Mixer MultiMedia5" "1"; do
    if (( ( i += 1 ) == 10 )); then
        echo "$0: giving up"
        break
    fi
    echo "$0: amixer failed, will retry"
    sleep 1
done

cset name="MultiMedia5 Mixer SLIM_0_TX" "1"
cset name="AIF1_CAP Mixer SLIM TX1" "1"
cset name="AIF1_CAP Mixer SLIM TX0" "1"
cset name="SLIM_0_TX Channels" "Two"
cset name="SLIM TX1 MUX" "DEC1"
cset name="SLIM TX0 MUX" "DEC0"
cset name="ADC MUX1" "AMIC"
cset name="ADC MUX0" "AMIC"
cset name="AMIC MUX1" "ADC2"
cset name="AMIC MUX0" "ADC3"
cset name="PCM_Dev 12 Topology Capture" "LL"

cset name="SLIM RX2 MUX" "AIF4_PB"
cset name="SLIM RX3 MUX" "AIF4_PB"
cset name="SLIM_6_RX Channels" "Two"
cset name="RX INT1_2 MUX" "RX2"
cset name="RX INT2_2 MUX" "RX3"
cset name="RX INT3_2 MUX" "RX3"
cset name="RX INT4_2 MUX" "RX2"
cset name="RX INT1 DEM MUX" "CLSH_DSM_OUT"
cset name="RX INT2 DEM MUX" "CLSH_DSM_OUT"
cset name="PCM_Dev 12 Topology Playback" "LL"

cset name="MultiMedia2 Mixer PRI_TDM_TX_0" "1"
cset name="PRI_TDM_TX_0 Channels" "Eight"
cset name="PRI_TDM_TX_0 SampleRate" "KHZ_16"
cset name="PCM_Dev 1 Topology Capture" "LL"

# I2S Path for HFP on MultiMedia9 (hw:0,14)
# Note that only RX_SD0_L (SLIM TX15) receives audio, though both
# to be configured in order for it to work. SLIM TX15 is the second channel of
# the two for MultiMedia9.
cset name="SLIMBUS_4_RX Audio Mixer MultiMedia9" "1"
cset name="SLIM RX1 MUX" "AIF5_PB"
cset name="SLIM_4_RX Channels" "One"
cset name="SLIM_4_RX SampleRate" "KHZ_16"
cset name="RX INT0_1 MIX1 INP0" "RX1"
cset name="BRIDGE MI2S RX Master Mode" "ON"
cset name="BRIDGE MI2S TX Master Mode" "ON"
cset name="BRIDGE RX Left1 Enable Switch" "1"
cset name="SLIM_2_TX Channels" "Two"
cset name="SLIM_2_TX SampleRate" "KHZ_16"
cset name="AIF4_CAP Mixer SLIM TX14" "1"
cset name="AIF4_CAP Mixer SLIM TX15" "1"
cset name="SLIM TX14 MUX" "RX_SD0_R"
cset name="SLIM TX15 MUX" "RX_SD0_L"
cset name="BRIDGE TX0 CLK Enable Switch" "1"
cset name="MultiMedia9 Mixer SLIM_2_TX" "1"
cset name="PCM_Dev 14 Topology Capture" "LL"
cset name="PCM_Dev 14 Topology Playback" "LL"
